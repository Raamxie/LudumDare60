[gd_resource type="Resource" script_class="Subtitles" format=3 uid="uid://b5l08e4hd6mvl"]

[ext_resource type="Script" uid="uid://cnd17qqqjxhr5" path="res://resources/Subtitle.gd" id="1_20io6"]
[ext_resource type="Script" uid="uid://p7jm27ayjkgj" path="res://resources/Subtites.gd" id="2_eypue"]

[sub_resource type="Resource" id="Resource_t5qvp"]
script = ExtResource("1_20io6")
text = "*WARNING* THE SHIP HAS BEEN CONTAMINATED *WARNING*"
hold_time = 3.0
typespeed = 25.0
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_thhn2"]
script = ExtResource("1_20io6")
text = "Wait, what day is it today?"
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_d1fou"]
script = ExtResource("1_20io6")
text = "I know they do test evacuations on every 200th cycle."
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_20io6"]
script = ExtResource("1_20io6")
text = "But the last one was..."
hold_time = 4.0
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_eypue"]
script = ExtResource("1_20io6")
text = "OH SHIT"
hold_time = 6.0
typespeed = 50.0
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_6bcmo"]
script = ExtResource("1_20io6")
text = "There was the crazy afterparty, which was just 142 days ago."
hold_time = 4.0
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_x7ohj"]
script = ExtResource("1_20io6")
text = "And that explains all that noise!"
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_54baw"]
script = ExtResource("1_20io6")
text = "We really have to hurry up sweetie."
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_kydxw"]
script = ExtResource("1_20io6")
text = "You got the cables, right?"
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_e6gl6"]
script = ExtResource("1_20io6")
text = "After that you need to calibrate the portal."
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_ij386"]
script = ExtResource("1_20io6")
text = "The two dials require specific setting"
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_ou8ml"]
script = ExtResource("1_20io6")
text = "The one on the right was set by Jarod, who is quite childish, so you can guess the number."
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_8ya0k"]
script = ExtResource("1_20io6")
text = "Nice."
hold_time = 4.0
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_h0nlu"]
script = ExtResource("1_20io6")
text = "Right one is done, and the left one is kept in secret, so people won't just randomly teleport while drunk."
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_jfu7f"]
script = ExtResource("1_20io6")
text = "There are rumors that the number is the Answer to the Ultimate Question of Life, the Universe, and Everything."
hold_time = 6.0
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_7xy76"]
script = ExtResource("1_20io6")
text = "I don't know what that means, so I would instead just ask Asha, but she left 100 days ago. The afterparty really pissed her off.."
hold_time = 6.0
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_76aor"]
script = ExtResource("1_20io6")
text = "And you need to wait for the machine to calibrate!!"
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_oodg5"]
script = ExtResource("1_20io6")
text = "*AAAAAAAAAAAAAAAAAAAA*"
typespeed = 40.0
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_7ifye"]
script = ExtResource("1_20io6")
text = "After that, you are almost home - just push the lever to the end and the teleport should just spring to life"
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

