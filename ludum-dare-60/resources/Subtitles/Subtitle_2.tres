[gd_resource type="Resource" script_class="Subtitles" format=3 uid="uid://x4bs6xhcel8t"]

[ext_resource type="Script" uid="uid://cnd17qqqjxhr5" path="res://resources/Subtitle.gd" id="1_2y1x8"]
[ext_resource type="Script" uid="uid://p7jm27ayjkgj" path="res://resources/Subtites.gd" id="2_3rjwf"]

[sub_resource type="Resource" id="Resource_mn7mm"]
script = ExtResource("1_2y1x8")
text = "God dammit! That one must've been broken."
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_bragp"]
script = ExtResource("1_2y1x8")
text = "Anyways, the guide will span across multiple tapes."
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_157pc"]
script = ExtResource("1_2y1x8")
text = "To prevent any confusion in repairing processes, the tapes cannot skip order."
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_y7fa2"]
script = ExtResource("1_2y1x8")
text = "This means, that the third tape will be able to be played only after the second one has been already played."
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_wmn6y"]
script = ExtResource("1_2y1x8")
text = "Fourth one will require the third one, fifth ... Did you hear about my fifth cousin?"
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_40odg"]
script = ExtResource("1_2y1x8")
text = "Her wife got selected to be the captain of the next expedition!"
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_5kx53"]
script = ExtResource("1_2y1x8")
text = "So exciting..."
typespeed = 25.0
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_gjtod"]
script = ExtResource("1_2y1x8")
text = "I wish I could be like her one day"
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

[sub_resource type="Resource" id="Resource_2y1x8"]
script = ExtResource("1_2y1x8")
text = "Just imagine it! Me. A captain..."
hold_time = 8.0
metadata/_custom_type_script = "uid://cnd17qqqjxhr5"

